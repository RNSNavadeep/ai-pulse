# ==========================================
# AI Pulse Agent - Environment Configuration
# ==========================================

# 1. Telegram Bot Credentials
# Obtain bot token from @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Obtain your Telegram Chat ID (e.g. from @userinfobot):
TELEGRAM_CHAT_ID=your_chat_id_here

# 2. Agent Settings
POLL_INTERVAL_SECONDS=300
MAX_NOTIFICATIONS_PER_RUN=5
LOG_LEVEL=INFO

# 3. Phase 3 Persistence & Polling Settings
DB_NAME=ai_pulse.db
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0
INITIAL_RUN_SEND_ALERTS=false

# 4. Phase 4 - Google Gemini Integration (Free-Tier Only)
# Get a free API key from Google AI Studio: https://aistudio.google.com/app/apikey
# Keep this secret! Never commit your real key to GitHub.
GEMINI_API_KEY=your_gemini_api_key_here

# Model explicitly available under the Gemini API Free Tier (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Quota Protection & Usage Controls:
# Limits calls per collection cycle to prevent rate-limit spikes
GEMINI_MAX_REQUESTS_PER_CYCLE=5

# Maximum daily calls across all cycles to remain well below the 1,500 RPD free-tier cap
GEMINI_DAILY_LIMIT=100

# Toggle LLM processing (set to false to force rule-based fallback mode)
LLM_ENABLED=true

# Per-request HTTP timeout in milliseconds (25 000 ms = 25 s)
GEMINI_REQUEST_TIMEOUT_MS=25000

# SDK-level internal retries for transient errors (default: 0, handled at app level)
GEMINI_MAX_SDK_RETRIES=0

